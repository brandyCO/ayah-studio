<?xml version="1.0" encoding="utf-8"?>
<!-- Prayer times (PrayerWidget), redrawn 2026-11-10: on a night card in the theme colours (WidgetArt), the
     next prayer large with its time and a live countdown, sunrise small beside the label, and the five
     prayers below (the next one in a pill, those passed dimmed). Small sizes keep only the top part. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/pw_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/pw_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/pw_sun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/pw_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:maxLines="2" />
                <Chronometer
                    android:id="@+id/pw_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:maxLines="1" />
            </LinearLayout>
            <TextView
                android:id="@+id/pw_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="32sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pw_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <LinearLayout android:id="@+id/pw_c0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="6dp" android:paddingBottom="6dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <TextView android:id="@+id/pw_n0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="1" android:ellipsize="none" />
                <TextView android:id="@+id/pw_t0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum" />
            </LinearLayout>
            <LinearLayout android:id="@+id/pw_c1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="6dp" android:paddingBottom="6dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <TextView android:id="@+id/pw_n1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="1" android:ellipsize="none" />
                <TextView android:id="@+id/pw_t1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum" />
            </LinearLayout>
            <LinearLayout android:id="@+id/pw_c2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="6dp" android:paddingBottom="6dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <TextView android:id="@+id/pw_n2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="1" android:ellipsize="none" />
                <TextView android:id="@+id/pw_t2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum" />
            </LinearLayout>
            <LinearLayout android:id="@+id/pw_c3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="6dp" android:paddingBottom="6dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <TextView android:id="@+id/pw_n3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="1" android:ellipsize="none" />
                <TextView android:id="@+id/pw_t3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum" />
            </LinearLayout>
            <LinearLayout android:id="@+id/pw_c4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="6dp" android:paddingBottom="6dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <TextView android:id="@+id/pw_n4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="1" android:ellipsize="none" />
                <TextView android:id="@+id/pw_t4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:fontFeatureSettings="tnum" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
