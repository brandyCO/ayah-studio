<?xml version="1.0" encoding="utf-8"?>
<!-- Tasbih on the home screen (TasbihWidget): tap the middle to count, ⟳ for the next dhikr. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/daily_widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tb_en"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/daily_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tb_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="⟳"
            android:textColor="@color/daily_accent"
            android:textSize="20sp"
            android:contentDescription="@string/tasbih_next" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tb_tap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/tasbih_tap_bg"
        android:contentDescription="@string/tasbih_count">
        <TextView
            android:id="@+id/tb_ar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/daily_text"
            android:textSize="18sp"
            android:textDirection="rtl"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="18sp" />
        <TextView
            android:id="@+id/tb_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/daily_text"
            android:textSize="34sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/tb_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/daily_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/tb_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="33"
        android:progressTint="@color/daily_accent" />
</LinearLayout>
