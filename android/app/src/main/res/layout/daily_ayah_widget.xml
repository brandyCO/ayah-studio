<?xml version="1.0" encoding="utf-8"?>
<!-- Ayah of the day (DailyAyahWidget): reference + translation in the system font. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/daily_widget_bg">

    <TextView
        android:id="@+id/daily_ref"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/daily_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/daily_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:textColor="@color/daily_text"
        android:textSize="16sp"
        android:lineSpacingMultiplier="1.15"
        android:textDirection="anyRtl"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="17sp"
        android:autoSizeStepGranularity="1sp" />

    <TextView
        android:id="@+id/daily_credit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/daily_muted"
        android:textSize="10sp"
        android:maxLines="1" />
</LinearLayout>
