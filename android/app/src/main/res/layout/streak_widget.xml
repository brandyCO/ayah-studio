<?xml version="1.0" encoding="utf-8"?>
<!-- The daily streak (StreakWidget): flame, days in a row, status, this week. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/st_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/streak_widget_bg">

    <ImageView
        android:id="@+id/st_flame"
        android:layout_width="46dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_flame"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">
            <TextView
                android:id="@+id/st_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFD58A"
                android:textSize="34sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/st_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="4dp"
                android:textColor="#FBEEE0"
                android:textSize="13sp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/st_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E9CFB4"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:id="@+id/st_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <ImageView android:id="@+id/st_d1" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginEnd="5dp" android:contentDescription="@null" />
            <ImageView android:id="@+id/st_d2" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginEnd="5dp" android:contentDescription="@null" />
            <ImageView android:id="@+id/st_d3" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginEnd="5dp" android:contentDescription="@null" />
            <ImageView android:id="@+id/st_d4" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginEnd="5dp" android:contentDescription="@null" />
            <ImageView android:id="@+id/st_d5" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginEnd="5dp" android:contentDescription="@null" />
            <ImageView android:id="@+id/st_d6" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginEnd="5dp" android:contentDescription="@null" />
            <ImageView android:id="@+id/st_d7" android:layout_width="12dp" android:layout_height="12dp" android:contentDescription="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/st_weeks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B99C84"
            android:textSize="11sp"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
