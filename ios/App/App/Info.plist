		<string>zh-Hans</string>
		<string>it</string>
		<string>nl</string>
		<string>ja</string>
		<string>ko</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>google-sign-in</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>GIDClientID</key>
	<string>$(GOOGLE_IOS_CLIENT_ID)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Ayah Studio uses your approximate location to work out prayer times and Ramadan iftar times.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Ayah Studio uses your approximate location to work out prayer times and Ramadan iftar times. It only asks while you use the app.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Ayah Studio listens while you recite, to follow your recitation and check it. Nothing is recorded or kept unless you choose to.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Ayah Studio saves the reels you make to your photos, so you can post them.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Ayah Studio turns your recitation into text on your iPhone to show the words as you say them.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
